{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Deno",

  "name": "@wormblossom/macromania-assets",
  "version": "1.0.0",
  "exports": "./mod.tsx",

  "imports": {
    "macromania": "jsr:@macromania/macromania@^0.2.0",
    "@wormblossom/macromania-fs": "jsr:@wormblossom/macromania-fs@^0.2.0",
    "@wormblossom/simple-fs-abstraction": "jsr:@wormblossom/simple-fs-abstraction@^0.1.1",
    "@wormblossom/simple-fs-deno": "jsr:@wormblossom/simple-fs-deno@^0.1.0",
    "@std/fs": "jsr:@std/fs@^1.0.18",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/assert": "jsr:@std/assert@^0.221.0"
  },

  "patch": [
    "../macromania",
    "../macromania_fs",
    "../simple_fs_abstraction"
  ],

  "compilerOptions": {
    "jsx": "react-jsxdev",
    "jsxImportSource": "macromania",
    "lib": ["deno.ns", "dom"],
    "strict": true
  },

  "tasks": {
    "test": "deno test test/tests.tsx"
  }
}
